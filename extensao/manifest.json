{
  "manifest_version": 3,
  "name": "MonitorPro Extrator",
  "version": "3.0",
  "description": "Extrator inteligente de resoluções do TEC Concursos para o MonitorPro.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://www.tecconcursos.com.br/*",
    "http://204.216.111.13/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.tecconcursos.com.br/*",
        "http://204.216.111.13/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
