# Configurações do Cliente (Vite/backend próprio)
# Em dev, o Vite faz proxy de /api para o backend (http://127.0.0.1:3000).
# Em produção, o Nginx faz o mesmo proxy — normalmente não precisa trocar.
VITE_API_URL=/api

# Configurações do Servidor (backend Fastify)
# Chave da API Groq usada pela rota /api/gemini (validação de JWT + LLM).
GROQ_API_KEY=
