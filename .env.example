# Configurações do Cliente (Vite/Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configurações do Servidor (Vercel Serverless / Supabase Edge Functions)
# IMPORTANTE: Esta chave deve ser configurada apenas no backend de produção e no seu ambiente local de desenvolvimento.
# Nunca coloque o prefixo VITE_ nela para evitar que o Vite a vaze no build do client-side.
GEMINI_API_KEY=
